{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daudau-autopack-print",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "print.daushop.pro.vn",
      "zone_name": "daushop.pro.vn",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
